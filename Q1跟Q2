# -*- coding: utf-8 -*-
"""
長輩 Q1 與 Q2 重點對比分析系統（最終完美對齊截圖版）
- B5:B6 垂直合併「活動類型」
- C5:H5 合併為 Q1 大標題，I5:N5 合併為 Q2 大標題
- 完整六大指標全名（參與度、自我功能、情緒控制力、與他人互動、肢體表現、參與場次）
- Q1 與 Q2 之間帶有粗黑垂直分隔線
- 僅保留單一精準總表分頁，無多餘分頁與空白
"""

import os
import re
import pandas as pd
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

target_activities = ['手部(大肢體)', '手部(精細)', '下肢', '上下肢全身', '認知', '【跨月份總平均】']
indicators = ['參與度', '自我功能', '情緒控制力', '與他人互動', '肢體表現', '參與場次']

if __name__ == '__main__':
    print('=' * 60)
    print('長輩 Q1 與 Q2 重點對比分析系統')
    print('=' * 60)

    all_files = [f for f in os.listdir('.') if f.endswith('.xlsx') and '平均報表_' in f and not f.startswith('~$')]
    
    if not all_files:
        print('【錯誤】找不到任何已產出的「平均報表」檔案！')
        exit()

    elder_master_data = {}
    elder_cms = {}

    for file_name in all_files:
        m = re.match(r'(.+?)平均報表_(.+)\.xlsx', file_name)
        if not m:
            continue
        
        quarter_name = m.group(1).strip()
        # 📌 鎖定 Q1 與 Q2 區間
        if quarter_name not in ['11501-11503', '11504-11506']:
            continue

        elder_name = m.group(2).strip()
        q_label = "Q1 (11501-11503)" if quarter_name == '11501-11503' else "Q2 (11504-11506)"

        file_path = os.path.join('.', file_name)
        try:
            wb_temp = openpyxl.load_workbook(file_path, data_only=True)
            ws1 = wb_temp.worksheets[0]
            
            sub_text = str(ws1['B3'].value or '')
            m_cms = re.search(r'CMS\s*([0-9０-９]+)', sub_text)
            if m_cms and elder_name not in elder_cms:
                elder_cms[elder_name] = m_cms.group(1)

            df_summary = pd.read_excel(file_path, sheet_name=0, header=None)
            
            header_row_idx = None
            for r in range(len(df_summary)):
                val = str(df_summary.iloc[r, 1]).strip()
                if val == '活動類型':
                    header_row_idx = r
                    break

            if header_row_idx is not None:
                if elder_name not in elder_master_data:
                    elder_master_data[elder_name] = {}

                for r in range(header_row_idx + 1, len(df_summary)):
                    act_type = str(df_summary.iloc[r, 1]).strip()
                    if not act_type or act_type == 'nan':
                        continue
                    
                    if act_type not in target_activities and '總平均' not in act_type and '跨月份總平均' not in act_type:
                        continue

                    if '總平均' in act_type or '跨月份總平均' in act_type:
                        act_type = '【跨月份總平均】'

                    if act_type not in elder_master_data[elder_name]:
                        elder_master_data[elder_name][act_type] = {}

                    row_scores = {}
                    orig_inds = ['參與度', '自我功能', '情緒控制力', '與他人互動', '肢體表現', '參與場次']
                    for c_idx, ind_name in enumerate(orig_inds):
                        val_score = df_summary.iloc[r, 2 + c_idx]
                        row_scores[indicators[c_idx]] = val_score if pd.notna(val_score) else 0.0

                    elder_master_data[elder_name][act_type][q_label] = row_scores

            print(f"  -> 成功載入 [{elder_name}] 的 [{q_label}] 數據")

        except Exception as e:
            print(f"  [讀取警告] {file_name}: {e}")

    print(f"\n" + "=" * 50)
    print("▶ 開始產出各長輩的 Q1 與 Q2 對比報表...")
    print("=" * 50)

    navy_header = PatternFill(start_color="1F4E79", end_color="1F4E79", fill_type="solid")
    navy_accent = PatternFill(start_color="2F5597", end_color="2F5597", fill_type="solid")
    zebra_fill = PatternFill(start_color="F9FAFB", end_color="F9FAFB", fill_type="solid")
    white_font = Font(name="微軟正黑體", size=11, bold=True, color="FFFFFF")
    title_font = Font(name="微軟正黑體", size=15, bold=True, color="1F4E79")
    subtitle_font = Font(name="微軟正黑體", size=10, color="595959")
    regular_font = Font(name="微軟正黑體", size=10)
    bold_font = Font(name="微軟正黑體", size=10, bold=True)
    
    thin_border = Border(
        left=Side(style='thin', color='D9D9D9'), right=Side(style='thin', color='D9D9D9'),
        top=Side(style='thin', color='D9D9D9'), bottom=Side(style='thin', color='D9D9D9')
    )
    split_border = Border(
        left=Side(style='thin', color='D9D9D9'), right=Side(style='medium', color='1F4E79'),
        top=Side(style='thin', color='D9D9D9'), bottom=Side(style='thin', color='D9D9D9')
    )

    for elder_name, act_data in elder_master_data.items():
        wb = openpyxl.Workbook()
        
        ws1 = wb.active
        ws1.title = "Q1與Q2橫向對比總表"
        ws1.views.sheetView[0].showGridLines = True

        cms_val = elder_cms.get(elder_name, '')
        cms_str = f"CMS {cms_val} 級" if cms_val else "CMS (未填)"

        ws1['B2'] = f"長輩【{elder_name}】Q1 與 Q2 活動指標與表現橫向對比總表"
        ws1['B2'].font = title_font
        ws1['B3'] = f"長照等級：{cms_str} ｜ 活動類型與五大核心指標第一季與第二季橫向並排追蹤"
        ws1['B3'].font = subtitle_font

        # B5:B6 垂直合併「活動類型」
        ws1.merge_cells('B5:B6')
        act_cell = ws1.cell(row=5, column=2, value="活動類型")
        act_cell.fill = navy_header
        act_cell.font = white_font
        act_cell.alignment = Alignment(horizontal="center", vertical="center")
        
        # Q1 大標題合併 C5:H5
        ws1.merge_cells('C5:H5')
        q1_title = ws1.cell(row=5, column=3, value="Q1 (11501-11503)")
        q1_title.fill = navy_header
        q1_title.font = white_font
        q1_title.alignment = Alignment(horizontal="center", vertical="center")

        # Q2 大標題合併 I5:N5
        ws1.merge_cells('I5:N5')
        q2_title = ws1.cell(row=5, column=9, value="Q2 (11504-11506)")
        q2_title.fill = navy_header
        q2_title.font = white_font
        q2_title.alignment = Alignment(horizontal="center", vertical="center")

        for c_idx in range(3, 15):
            cell = ws1.cell(row=6, column=c_idx, value=indicators[(c_idx - 3) % 6])
            cell.fill = navy_accent
            cell.font = white_font
            cell.alignment = Alignment(horizontal="center", vertical="center")

        ws1.row_dimensions[5].height = 22
        ws1.row_dimensions[6].height = 22
        ws1.cell(row=6, column=2).fill = navy_header

        current_row = 7
        row_idx_counter = 0

        for act_type in target_activities:
            if act_type not in act_data:
                continue

            ws1.cell(row=current_row, column=2, value=act_type).font = bold_font
            ws1.cell(row=current_row, column=2).alignment = Alignment(horizontal="left", vertical="center")
            ws1.cell(row=current_row, column=2).border = thin_border

            # Q1 數據 (欄 3 到 8)
            q1_scores = act_data[act_type].get("Q1 (11501-11503)", {})
            for idx, ind in enumerate(indicators):
                col = 3 + idx
                val = q1_scores.get(ind, 0.0)
                cell = ws1.cell(row=current_row, column=col, value=val)
                cell.font = regular_font
                cell.alignment = Alignment(horizontal="center", vertical="center")
                cell.border = split_border if col == 8 else thin_border
                cell.number_format = '0' if ind == '參與場次' else '0.0'

            # Q2 數據 (欄 9 到 14)
            q2_scores = act_data[act_type].get("Q2 (11504-11506)", {})
            for idx, ind in enumerate(indicators):
                col = 9 + idx
                val = q2_scores.get(ind, 0.0)
                cell = ws1.cell(row=current_row, column=col, value=val)
                cell.font = regular_font
                cell.alignment = Alignment(horizontal="center", vertical="center")
                cell.border = thin_border
                cell.number_format = '0' if ind == '參與場次' else '0.0'

            if row_idx_counter % 2 == 1:
                for c in range(2, 15):
                    ws1.cell(row=current_row, column=c).fill = zebra_fill

            ws1.row_dimensions[current_row].height = 20
            current_row += 1
            row_idx_counter += 1

        for col in ws1.columns:
            col_letter = get_column_letter(col[0].column)
            if col_letter == 'B':
                ws1.column_dimensions[col_letter].width = 16
            else:
                max_len = max(sum(2 if ord(char) > 127 else 1 for char in str(cell.value or '')) for cell in col)
                ws1.column_dimensions[col_letter].width = max(max_len + 3, 11)
        ws1.column_dimensions['A'].width = 4

        safe_name = re.sub(r'[\\/:*?"<>|]', '', elder_name).strip()
        output_file = f'Q1與Q2重點對比報表_{safe_name}.xlsx'
        wb.save(output_file)
        print(f"  [完成對比報表] {elder_name} -> {output_file}")

    print('\n' + '=' * 60)
    print('🎉 所有長輩的 Q1 與 Q2 對比分析報表已順利產出！')
    print('=' * 60)
